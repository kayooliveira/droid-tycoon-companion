{
  "name": "droid-tycoon-companion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && eslint src && bash scripts/check-theme-tokens.sh",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview --host",
    "preview:e2e": "npm run build && vite preview --host 127.0.0.1 --port 4173",
    "generate:icons": "node scripts/generate-icons.mjs",
    "sync:wiki-images": "node scripts/sync-wiki-images.mjs",
    "generate:ux-screenshots": "UX_ARTIFACTS_DIR=/opt/cursor/artifacts playwright test e2e/ux-screenshots.spec.ts",
    "test:docker-nginx": "bash scripts/docker-nginx-mime-smoke.sh"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "buffer": "^6.0.3",
    "i18next": "^26.6.0",
    "motion": "^14.9.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
